{
  "name": "mercury-composable",
  "version": "0.1.0",
  "description": "Lightweight Event-over-HTTP function host and client for Mercury Composable",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Accenture Technology",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Accenture/mercury-nodejs.git"
  },
  "homepage": "https://accenture.github.io/mercury-composable",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "mercury-serve": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && node --test dist/test/*.test.js",
    "prepack": "tsc -p ."
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
